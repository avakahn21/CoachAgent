# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Google Sheets (paste the full JSON of your service account key here, as a single line)
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com",...}

# Plaid — set all three to activate live transaction pulling
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox   # change to "production" when going live

# App
# Local testing: set to your ngrok URL (e.g. https://abc123.ngrok.io)
# Production (Railway): set to your Railway URL (e.g. https://your-app.railway.app)
APP_BASE_URL=https://your-app.railway.app

# Flask
FLASK_ENV=production
TWILIO_VALIDATE_SIGNATURES=true
